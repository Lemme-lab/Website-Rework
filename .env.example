# Booking form endpoint.
# Get a free access key at https://web3forms.com - enter your email address and
# the key arrives by mail. No account required.
#
# This key is safe to ship in the client bundle: it only permits delivery to the
# email address it was issued to, so it cannot be abused to send mail elsewhere.
#
# Copy this file to ".env" and drop your key in. Restart the dev server after.
VITE_WEB3FORMS_ACCESS_KEY=d03920df-a91f-4f3c-98e6-9f774513beb5
